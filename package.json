{
  "name": "tricastle_web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:force": "lsof -ti:5173 | xargs kill -9 2>/dev/null; vite",
    "dev:clean": "rm -rf node_modules/.vite && lsof -ti:5173 | xargs kill -9 2>/dev/null; vite",
    "kill": "lsof -ti:5173 | xargs kill -9 2>/dev/null || true",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "clean": "rm -rf node_modules/.vite dist"
  },
  "dependencies": {
    "@primevue/themes": "^4.5.4",
    "@vee-validate/zod": "^4.15.1",
    "@vue-leaflet/vue-leaflet": "^0.10.1",
    "@vueuse/core": "^14.3.0",
    "axios": "^1.18.1",
    "chart.js": "^4.5.1",
    "file-saver": "^2.0.5",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "pinia": "^4.0.2",
    "pinia-plugin-persistedstate": "^4.7.1",
    "primeicons": "^8.0.0",
    "primevue": "^4.5.5",
    "pubnub": "^12.0.3",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.39",
    "vue-router": "^4.6.4",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/file-saver": "^2.0.7",
    "@types/jspdf": "^1.3.3",
    "@types/jszip": "^3.4.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.21",
    "tailwindcss": "^3.4.19",
    "vite": "^8.1.1",
    "vue-tsc": "^3.3.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
